{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|webp|ico|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self)"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/where-we-met",
      "destination": "/where-we-met/index.html"
    },
    {
      "source": "/where-we-met-map",
      "destination": "/where-we-met/index.html"
    },
    {
      "source": "/she-said-yes",
      "destination": "/she-said-yes/index.html"
    },
    {
      "source": "/our-wedding-day",
      "destination": "/our-wedding-day/index.html"
    },
    {
      "source": "/our-first-home",
      "destination": "/our-first-home/index.html"
    },
    {
      "source": "/travel-memories",
      "destination": "/travel-memories/index.html"
    },
    {
      "source": "/marathon-race",
      "destination": "/marathon-race/index.html"
    },
    {
      "source": "/baby-arrival",
      "destination": "/baby-arrival/index.html"
    },
    {
      "source": "/hometown-roots",
      "destination": "/hometown-roots/index.html"
    },
    {
      "source": "/mountain-summit",
      "destination": "/mountain-summit/index.html"
    },
    {
      "source": "/((?!api/|assets/|docs/|privacy|imprint|terms|refund|cities/|where-we-met|she-said-yes|our-wedding-day|our-first-home|travel-memories|marathon-race|baby-arrival|hometown-roots|mountain-summit|robots\\.txt|sitemap\\.xml|ads\\.txt|site\\.webmanifest|sw\\.js|llms\\.txt|google.*|BingSiteAuth.*|favicon|icon).*)$",
      "destination": "/index.html"
    }
  ]
}